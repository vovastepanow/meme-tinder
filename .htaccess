# Наружу открыты только интерфейс (index.html, js/, css/, fonts/, img/, media_cache/) и API (index.php).
# Нужен AllowOverride All для каталога сайта (sudo sh tools/apache-setup.sh).
Options -Indexes

# Данные, журналы, блокировки, секреты и служебные файлы; все PHP, кроме index.php
<FilesMatch "(^\.|\.(json|log|lock|md|backup|php)$)">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(.*/)?(lib|handlers|tools|users|\.git)(/|$)
</IfModule>

# JS/CSS/HTML браузер каждый раз сверяет (ETag); файлы кэша медиа неизменяемы (имя — хэш адреса) и хранятся неделю
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#/media_cache/#">
        Header set Cache-Control "public, max-age=604800, immutable"
    </If>
</IfModule>

# Редактор поста загружает видео и картинки перед отправкой в Telegram
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 400M
    php_value max_file_uploads 20
    php_value max_input_time 300
</IfModule>
